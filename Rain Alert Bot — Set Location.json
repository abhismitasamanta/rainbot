    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=👋 Welcome to the Rain Alert bot! I'll message you every morning at 7:10 AM when rain is expected at your place.\n\n📍 To get started, send me your location in this format:\n\nCity, State, Country\n\nFor example: Sambalpur, Odisha, India",
        "additionalFields": {}
      },
      "id": "c9a6ae93-d84b-4d3c-b9c0-1f0deca99dca",
      "name": "Ask Location Welcome",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        112,
        448
      ],
      "webhookId": "6efc9ee9-e452-46f3-a748-8b4663d60b26",
      "credentials": {
        "telegramApi": {
          "id": "WHxIz0PzcWDVdBsb",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $json.message || {};\nconst text = (msg.text || '').trim();\nconst parts = text.split(',').map(p => p.trim()).filter(p => p.length > 0);\nconst formatOk = parts.length >= 2 && parts.length <= 3;\n// OpenWeatherMap resolves \"City, Country\" reliably but not \"City, State, Country\",\n// so validate with city + last part (country) while keeping the full text for replies.\nconst lookupQuery = parts.length === 3 ? parts[0] + ', ' + parts[2] : parts.join(', ');\nreturn { json: { chat_id: msg.chat.id, locationQuery: parts.join(', '), lookupQuery, formatOk } };"
      },
      "id": "ce719ef4-43ff-45c3-886e-67c4358fa7b8",
      "name": "Check Format",
